# Ollama model used by test_generator.py and web_test_generator.py
OLLAMA_MODEL=qwen3.5:9b

# Context window in tokens (prompt + reply). Raise it if you see "reply was cut off"; higher uses more memory.
OLLAMA_NUM_CTX=16384

# Maximum number of tests to generate per run. Fewer tests = smaller prompts and faster runs.
MAX_TESTS=10

# Show the browser window while exploring and running web tests (true/false)
HEADED=false

URL="https://www.fourseasons.com/find_a_hotel_or_resort/"